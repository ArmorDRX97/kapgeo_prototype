{
  "name": "ai-kapgeo-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:knowledge-map && tsc -b && vite build && npm run verify:knowledge-map-build",
    "validate:knowledge-map": "node src/internal/knowledge-map/scripts/validate-data.mjs && node src/internal/knowledge-map/scripts/check-isolation.mjs",
    "verify:knowledge-map-build": "node src/internal/knowledge-map/scripts/check-isolation.mjs --built",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kapgeo/geo-viz": "file:packages/geo-viz",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.31.0",
    "polygon-clipping": "0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
